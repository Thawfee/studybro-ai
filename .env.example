# ============================================================
# StudyBro AI — environment variables
# Copy this file to `.env.local` and fill in values as needed.
# The current build runs fully local-first and needs NONE of these,
# but they are the seams for the future Python AI backend + database.
# NEVER commit real secrets. .env.local is gitignored by default.
# ============================================================

# --- Future real-time AI backend (Python / FastAPI / WebSocket) ---
# When you wire up the OpenCV/MediaPipe/YOLO backend, point the frontend at it.
# Example: ws://localhost:8000/ws
NEXT_PUBLIC_AI_WS_URL=

# --- Future database (PostgreSQL + Prisma) ---
# Example: postgresql://user:password@localhost:5432/studybro
DATABASE_URL=

# --- Optional: public app URL (for metadata / OG) ---
NEXT_PUBLIC_APP_URL=http://localhost:3000
